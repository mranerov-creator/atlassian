# ===========================================
# BlueVektor Agents - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# -----------------------------
# LLM Configuration
# -----------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxx  # Optional: for embeddings

# Model selection
DEFAULT_MODEL=claude-sonnet-4-20250514
REASONING_MODEL=claude-opus-4-20250514
FAST_MODEL=claude-haiku-3-20240307

# Local LLM (optional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# -----------------------------
# Database
# -----------------------------
POSTGRES_USER=bluevektor
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=bluevektor_agents
DATABASE_URL=postgresql://bluevektor:your_secure_password_here@localhost:5432/bluevektor_agents

# -----------------------------
# Redis
# -----------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------
# Atlassian Integration
# -----------------------------
ATLASSIAN_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=your-email@domain.com
ATLASSIAN_API_TOKEN=your_api_token_here

# -----------------------------
# Google Workspace (optional)
# -----------------------------
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
GOOGLE_DELEGATED_EMAIL=your-email@domain.com

# -----------------------------
# LinkedIn (optional - via Phantombuster or similar)
# -----------------------------
PHANTOMBUSTER_API_KEY=your_api_key_here

# -----------------------------
# Application
# -----------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Human-in-the-loop webhook (Slack, email, etc.)
HITL_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx

# -----------------------------
# Security
# -----------------------------
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
